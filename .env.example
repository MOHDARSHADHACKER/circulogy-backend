# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=9129806460@Aziz
DB_NAME=circulogy_cms

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
SESSION_HOURS=24
COOKIE_NAME=circulogy_admin_token
# lax  = frontend and API on the same site (localhost, or same domain)
# none = frontend and API on different domains (requires HTTPS)
COOKIE_SAMESITE=lax

# ---- First admin account (used by `npm run seed`) ----
ADMIN_NAME=Circulogy Admin
ADMIN_EMAIL=admin@circulogy.com
ADMIN_PASSWORD=ChangeMe@12345
